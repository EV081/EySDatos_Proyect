      "updated": 1789937873968,
      "link": null,
      "locked": false,
      "text": "RF11: si el tag GCM no valida, el cliente rechaza el mensaje y lo identifica como no descifrable. RS4: nonce de 96 bits por CSPRNG, jamás reutilizado.",
      "fontSize": 14,
      "autoResize": true,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect41",
      "originalText": "RF11: si el tag GCM no valida, el cliente rechaza el mensaje y lo identifica como no descifrable. RS4: nonce de 96 bits por CSPRNG, jamás reutilizado.",
      "lineHeight": 1.25,
      "fontFamily": 1,
      "baseline": 3.5
    }
