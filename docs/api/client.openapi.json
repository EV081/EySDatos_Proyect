            "type": "string",
            "pattern": "^[0-9]{1,25}$",
            "title": "Discord Id"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 10,
            "title": "Password"
          },
          "consent_version": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Consent Version"
          }
        },
        "type": "object",
        "required": [
          "discord_id",
          "password",
          "consent_version"
        ],
        "title": "CreateIdentity"
      },
      "ExportRequest": {
