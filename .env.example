# Copiar a .env y completar. El .env real nunca se versiona. Las URLs se escriben completas (sin ${...}).

# --- Postgres (docker-compose.yml) -------------------------------------------
POSTGRES_PASSWORD=
# Solo para crear roles y aplicar migraciones (python -m directory.migrations.apply)
DATABASE_ADMIN_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:55432/directory
DIRECTORY_APP_PASSWORD=
# Lo que usa el servicio: el rol de mínimos permisos
DATABASE_URL=postgresql://directory_app:<DIRECTORY_APP_PASSWORD>@127.0.0.1:55432/directory

# --- OAuth2 de Discord (Developer Portal > OAuth2, alcance identify) ----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://localhost:8443/auth/callback

# --- Bot de Discord de cada persona (Developer Portal > Bot) -----------------
# Token de TU bot y el ID del canal privado #e2ee-relay (modo desarrollador > Copiar ID)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# --- Registros: clave de seudonimización (base64url de 32 bytes) ------------
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PSEUDONYM_KEY=
# Carpeta de registros de auditoría y alertas (rotación diaria, 90 días)
AUDIT_LOG_DIR=logs
# Opcional: webhook de un canal privado de operadores para las alertas (sin datos personales)
ALERT_WEBHOOK_URL=

# --- TLS 1.3 con CA propia (python -m ops.certs.pki init) ---------------------
# Protege la llave privada de la CA (mínimo 12 caracteres)
CA_KEY_PASSWORD=

# --- Copias de seguridad (python -m ops.backup.backup create) ----------------
DIRECTORY_BACKUP_PASSWORD=
BACKUP_DATABASE_URL=postgresql://directory_backup:<DIRECTORY_BACKUP_PASSWORD>@127.0.0.1:55432/directory
# base64url de 32 bytes; guárdala FUERA del servidor (sin ella las copias no sirven)
BACKUP_KEY=
# Fuera del servidor del directorio: otro disco, recurso de red o carpeta sincronizada
BACKUP_DIR=

# --- Cliente local ----------------------------------------------------------
DIRECTORY_URL=https://localhost:8443
DIRECTORY_CA_FILE=ops/certs/ca.pem
DIRECTORY_CRL_FILE=ops/certs/crl.pem
# Archivo donde `python -m directory.client_lib.login` guarda el token de registro
DIRECTORY_AUTH_TOKEN_FILE=./data/directory-token
