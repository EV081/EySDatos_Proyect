# Laptop: cliente local conectado al directorio de EC2 y frontend.
# Copiar a .env y completar los valores vacíos y HOST_EC2.
# Guía: docs/guia/ejecucion-local.md. El .env real nunca se versiona.

# --- Directorio remoto y certificados públicos recibidos del responsable -----
DIRECTORY_URL=https://HOST_EC2:8443
DIRECTORY_CA_FILE=ops/certs/ca.pem
DIRECTORY_CRL_FILE=ops/certs/crl.pem
# El login con Discord y Authenticator guarda aquí el token de registro.
DIRECTORY_AUTH_TOKEN_FILE=./data/directory-token

# --- Bot propio y canal privado compartido ----------------------------------
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# --- API del cliente y frontend ---------------------------------------------
# Generar con: openssl rand -hex 32
CLIENT_API_TOKEN=
CLIENT_DATA_DIR=./data
CLIENT_SESSION_TTL=1800
CLIENT_ALLOWED_ORIGIN=http://127.0.0.1:5173
