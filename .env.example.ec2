# EC2: directorio con PostgreSQL en Supabase y copias cifradas en S3.
# Copiar a .env y completar según docs/guia/despliegue-ec2.md.
# El .env real nunca se versiona. Escribir las URLs completas, sin ${...}.

# --- API: rol de aplicación de Supabase, nunca el administrador --------------
# Sustituir PROJECT_REF, CONTRASENA_ROL_APP y POOLER_HOST.
# Esta ruta del certificado es la que ve el contenedor del directorio.
DATABASE_URL='postgresql://directory_app.PROJECT_REF:CONTRASENA_ROL_APP@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/app/ops/certs/supabase-ca.pem'

# --- Aplicación OAuth2 de Discord, distinta de los bots de cada persona ------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://HOST_EC2:8443/auth/callback

# --- Claves independientes: generar cada una una sola vez --------------------
# Para cada clave: openssl rand -base64 32 | tr '+/' '-_'
# Conservar respaldos protegidos fuera de EC2; no regenerar al reiniciar.
PSEUDONYM_KEY=
# Cambiarla sin recifrar la base impide validar los autenticadores vinculados.
TOTP_ENCRYPTION_KEY=
# Opcional: webhook privado de operadores. Compose fija la carpeta de auditoría.
ALERT_WEBHOOK_URL=

# --- Respaldos: completar antes de make backup-remote (guía, paso 8) ----------
# Rol de solo lectura. Esta ruta del certificado corresponde al host EC2.
BACKUP_DATABASE_URL='postgresql://directory_backup.PROJECT_REF:CONTRASENA_ROL_RESPALDO@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/home/ubuntu/EySDatos_Proyect/ops/certs/supabase-ca.pem'
# Generar otra clave base64url de 32 bytes; guardarla fuera de EC2 y del bucket.
BACKUP_KEY=
BACKUP_DIR=/var/tmp/eysd-backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=directory
AWS_REGION=us-east-1

# Las credenciales administrativas van en .env.migraciones (guía, paso 4).
# La CA privada y su contraseña permanecen en la computadora responsable.
# AWS CLI usa el rol de EC2; no guardar claves de acceso AWS en este archivo.
